# OPC UA SendBox — переменные окружения (см. CLAUDE.md, раздел «Env»).
# Скопируйте в .env и поправьте под окружение. Секретов у сервиса нет.
# Дефолты в коде (app/config.py) совпадают с этим файлом.

# --- OPC UA -------------------------------------------------------------------

# Хост, который серверы объявляют клиентам в endpoint (GetEndpoints).
# Своя инсталляция — свой домен или IP.
OPCUA_PUBLIC_HOST=opcua-sendbox.electroman.by

# Адрес прослушивания OPC UA; пусто — все интерфейсы, IPv4 и IPv6 (ADR-002).
OPCUA_BIND_HOST=

# Порт общего демо-сервера. 4840 — стандартный порт OPC UA; на машине
# разработчика его часто занимает OPC Foundation LDS — тогда возьмите другой.
OPCUA_SHARED_PORT=4840

# Диапазон портов личных сессий (включительно), не пересекается с общим.
OPCUA_SESSION_PORT_MIN=4841
OPCUA_SESSION_PORT_MAX=5000

# --- лимиты -------------------------------------------------------------------

SESSIONS_PER_KEY=2
SESSIONS_PER_IP=4
SESSIONS_TOTAL=50
TAGS_PER_SESSION=100
ALARMS_PER_SESSION=20

# Закрытие сессии: простой без API-вызовов и OPC UA клиентов, с
SESSION_IDLE_TIMEOUT_S=1800
# Потолок жизни сессии, с (действует даже при подключённых клиентах)
SESSION_MAX_LIFETIME_S=14400

# Глубина истории HistoryRead каждого тега, значений
HISTORY_SIZE=1000

# Сколько ждать запуска сервера сессии, с
WORKER_START_TIMEOUT_S=10

# Частота снимков значений для WebSocket UI, Гц
WS_STATE_HZ=2

# Изменения из UI/REST (сессии, теги, алармы) на IP в минуту
WEB_MAX_WRITE_PER_MIN_PER_IP=50

# Выдача API-ключей на IP в час
KEYS_PER_HOUR_PER_IP=10

# --- web и логи -----------------------------------------------------------------

# Адрес и порт web UI/REST/WS (python -m app)
WEB_HOST=127.0.0.1
WEB_PORT=8766

# Адреса обратного прокси, которым uvicorn доверяет в X-Forwarded-For
# (через запятую; "*" — только если сервис недоступен извне напрямую)
FORWARDED_ALLOW_IPS=127.0.0.1

# Формат логов: text (разработка) или json (одна строка JSON на событие)
LOG_FORMAT=text

# Уровень логов: debug, info, warning, error
LOG_LEVEL=info
